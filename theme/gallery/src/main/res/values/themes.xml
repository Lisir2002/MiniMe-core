<?xml version="1.0" encoding="utf-8"?>
<resources>

    <string name="app_name">Design Gallery</string>

    <!--
      窗口主题：只负责 Compose 接管前的窗口外观（§8.2 首帧不闪）。
      真正的主题由 MiniMeTheme 在 setContent 内提供；MainActivity 会在
      onCreate 里把 window 背景替换为快照的 bgCanvas（暗色主题不闪白）。
    -->
    <style name="Theme.MiniMeGallery" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/gallery_window_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
    </style>

</resources>
