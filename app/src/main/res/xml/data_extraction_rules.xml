<?xml version="1.0" encoding="utf-8"?>
<!--
  DB-SHIELD-PERSIST-1 RC68 P0-1：Android 12+ 自动备份细粒度规则（dataExtractionRules）。
  升级 APK 时允许系统 / OEM 换机克隆 / 云备份 自动保存：
    - databases/ 下的所有 Room SQLite（含 minime_agent.db .wal .shm）
    - files/database_crashes/（Funnel4 崩溃备份）
    - files/zth_*/（ZTH 加密相关元数据）
    - shared_prefs/（设置项 DataStore 不在这里，语言/保活/日志等级走这个）

  安全红线（密钥/凭据绝不进 Google 云备份与设备迁移）：
    - 排除 sharedpref "minime_unified_keys"：EncryptedSharedPreferences 里存放
      数据库 DEK（主密钥包裹后的对称密钥）。即便 MasterKey 在硬件 Keystore 不可导出，
      也不把 DEK 信封随云备份带走。
    - 排除 database "minime_credentials_v2.db"（含 -wal/-shm）：凭据库本身是密文，
      与 DEK 一起出现在云端等于双重冗余，按最小权限原则直接不带走。
    - 排除 cache/、code_cache/、no_backup/ 临时文件。
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="." />
        <include domain="file" path="database_crashes" />
        <include domain="file" path="zth_security" />
        <include domain="sharedpref" path="." />
        <exclude domain="database" path="minime_credentials_v2.db" />
        <exclude domain="database" path="minime_credentials_v2.db-wal" />
        <exclude domain="database" path="minime_credentials_v2.db-shm" />
        <exclude domain="sharedpref" path="minime_unified_keys" />
        <exclude domain="cache" path="." />
        <exclude domain="code_cache" path="." />
        <exclude domain="no_backup" path="." />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="." />
        <include domain="file" path="database_crashes" />
        <include domain="file" path="zth_security" />
        <include domain="sharedpref" path="." />
        <exclude domain="database" path="minime_credentials_v2.db" />
        <exclude domain="database" path="minime_credentials_v2.db-wal" />
        <exclude domain="database" path="minime_credentials_v2.db-shm" />
        <exclude domain="sharedpref" path="minime_unified_keys" />
        <exclude domain="cache" path="." />
        <exclude domain="code_cache" path="." />
        <exclude domain="no_backup" path="." />
    </device-transfer>
</data-extraction-rules>
