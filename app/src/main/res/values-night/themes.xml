<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 深色模式冷启动窗口背景：与应用深色背景色 #0F172A 一致，避免纯黑与深蓝灰背景之间的跳变 -->
    <style name="Theme.MiniMeCore" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">#0F172A</item>
    </style>

    <!-- 系统级启动画面主题（深色）：与浅色版共享图标，背景取深色窗口色。 -->
    <style name="Theme.MiniMeCore.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#0F172A</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_logo</item>
        <item name="windowSplashScreenAnimationDuration">0</item>
        <item name="postSplashScreenTheme">@style/Theme.MiniMeCore</item>
    </style>
</resources>
