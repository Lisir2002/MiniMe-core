{
  "scopeName": "source.mel",
  "name": "MEL",
  "extensions": [
    "mel"
  ],
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#numbers"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.mel",
          "match": "//.*$"
        },
        {
          "name": "comment.block.mel",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.mel",
          "begin": "\"",
          "end": "\""
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.mel",
          "match": "\\b(if|else|for|while|do|break|continue|return|switch|case|default|catch|try|throw|global|proc|local|int|float|string|vector|matrix|boolean|void|true|false|yes|no|on|off)\\b"
        },
        {
          "name": "entity.name.function.mel",
          "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*(?=\\s*\\()"
        }
      ]
    },
    "numbers": {
      "name": "constant.numeric.mel",
      "match": "\\b-?\\d+\\.?\\d*\\b"
    }
  }
}