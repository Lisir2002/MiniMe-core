{
  "name": "Thrift",
  "scopeName": "source.thrift",
  "fileTypes": [
    "thrift"
  ],
  "patterns": [
    {
      "name": "comment.line.//.Thrift",
      "match": "//.*$"
    },
    {
      "name": "string.quoted.double.Thrift",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.Thrift",
          "match": "\\\\."
        }
      ]
    },
    {
      "name": "string.quoted.single.Thrift",
      "begin": "'",
      "end": "'",
      "patterns": [
        {
          "name": "constant.character.escape.Thrift",
          "match": "\\\\."
        }
      ]
    },
    {
      "name": "keyword.control.Thrift",
      "match": "\\b(namespace|include|typedef|enum|struct|union|exception|service|extends|required|optional|void|bool|byte|i16|i32|i64|double|string|binary)\\b"
    },
    {
      "name": "constant.numeric.Thrift",
      "match": "\\b\\d+(\\.\\d+)?\\b"
    }
  ]
}