-- qqbot 域 v1 schema
-- 生成类：QBotDb / QBotQueries（包 com.mini.me_core.datalayer.sqldelight.qqbot）
-- QQ 机器人聊天记录独立存储，与程序内 AI 对话（agent_session/agent_message）完全隔离。

-- 会话表：群聊和私聊统一建模
CREATE TABLE qqbot_session (
  session_id         TEXT    NOT NULL PRIMARY KEY,
  type               TEXT    NOT NULL,
  group_id           INTEGER,
  user_id            INTEGER,
  group_name         TEXT,
  user_name          TEXT,
  last_message       TEXT,
  last_message_time  INTEGER,
  unread_count       INTEGER NOT NULL DEFAULT 0,
  bot_qq             INTEGER NOT NULL DEFAULT 0,
  created_at         INTEGER NOT NULL,
  updated_at         INTEGER NOT NULL
);
CREATE INDEX qqbot_session_updated_idx ON qqbot_session (updated_at);
CREATE INDEX qqbot_session_type_idx ON qqbot_session (type);

-- 消息表：存储 QQ 消息和机器人回复
CREATE TABLE qqbot_message (
  message_id      TEXT    NOT NULL PRIMARY KEY,
  session_id      TEXT    NOT NULL,
  sender_id       INTEGER NOT NULL,
  sender_name     TEXT    NOT NULL DEFAULT '',
  sender_avatar   TEXT,
  sender_role     TEXT    NOT NULL DEFAULT 'MEMBER',
  content_type    TEXT    NOT NULL DEFAULT 'TEXT',
  content         TEXT    NOT NULL DEFAULT '',
  raw_message     TEXT,
  bot_reply_id    TEXT,
  timestamp       INTEGER NOT NULL,
  is_bot          INTEGER NOT NULL DEFAULT 0,
  FOREIGN KEY (session_id) REFERENCES qqbot_session(session_id)
);
CREATE INDEX qqbot_message_session_idx ON qqbot_message (session_id, timestamp);
CREATE INDEX qqbot_message_sender_idx ON qqbot_message (sender_id);

-- 群成员缓存表：群名片、昵称、头像、角色
CREATE TABLE qqbot_group_member (
  group_id     INTEGER NOT NULL,
  user_id      INTEGER NOT NULL,
  card         TEXT    NOT NULL DEFAULT '',
  nickname     TEXT    NOT NULL DEFAULT '',
  avatar       TEXT,
  role         TEXT    NOT NULL DEFAULT 'MEMBER',
  last_active  INTEGER NOT NULL DEFAULT 0,
  updated_at   INTEGER NOT NULL,
  PRIMARY KEY (group_id, user_id)
);
CREATE INDEX qqbot_group_member_group_idx ON qqbot_group_member (group_id);

-- 会话查询：按更新时间倒序
selectAllSessions:
SELECT * FROM qqbot_session ORDER BY updated_at DESC;

selectSessionsByType:
SELECT * FROM qqbot_session WHERE type = ? ORDER BY updated_at DESC;

selectSessionById:
SELECT * FROM qqbot_session WHERE session_id = ?;

upsertSession:
INSERT INTO qqbot_session (
  session_id, type, group_id, user_id, group_name, user_name,
  last_message, last_message_time, unread_count, bot_qq, created_at, updated_at
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)
ON CONFLICT(session_id) DO UPDATE SET
  group_name = excluded.group_name,
  user_name = excluded.user_name,
  last_message = excluded.last_message,
  last_message_time = excluded.last_message_time,
  unread_count = excluded.unread_count,
  updated_at = excluded.updated_at;

updateSessionLastMessage:
UPDATE qqbot_session SET last_message = ?, last_message_time = ?, updated_at = ? WHERE session_id = ?;

incrementUnreadCount:
UPDATE qqbot_session SET unread_count = unread_count + 1 WHERE session_id = ?;

resetUnreadCount:
UPDATE qqbot_session SET unread_count = 0 WHERE session_id = ?;

deleteSession:
DELETE FROM qqbot_session WHERE session_id = ?;

-- 消息查询
selectMessagesBySession:
SELECT * FROM qqbot_message WHERE session_id = ? ORDER BY timestamp ASC;

selectMessagesBySessionLimit:
SELECT * FROM qqbot_message WHERE session_id = ? ORDER BY timestamp DESC LIMIT ?;

selectMessageById:
SELECT * FROM qqbot_message WHERE message_id = ?;

insertMessage:
INSERT OR REPLACE INTO qqbot_message (
  message_id, session_id, sender_id, sender_name, sender_avatar,
  sender_role, content_type, content, raw_message, bot_reply_id, timestamp, is_bot
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

deleteMessagesBySession:
DELETE FROM qqbot_message WHERE session_id = ?;

deleteMessageById:
DELETE FROM qqbot_message WHERE message_id = ?;

-- 群成员查询
selectGroupMembers:
SELECT * FROM qqbot_group_member WHERE group_id = ? ORDER BY role DESC, nickname ASC;

selectGroupMember:
SELECT * FROM qqbot_group_member WHERE group_id = ? AND user_id = ?;

upsertGroupMember:
INSERT INTO qqbot_group_member (
  group_id, user_id, card, nickname, avatar, role, last_active, updated_at
) VALUES (?, ?, ?, ?, ?, ?, ?, ?)
ON CONFLICT(group_id, user_id) DO UPDATE SET
  card = excluded.card,
  nickname = excluded.nickname,
  avatar = excluded.avatar,
  role = excluded.role,
  last_active = excluded.last_active,
  updated_at = excluded.updated_at;

updateMemberLastActive:
UPDATE qqbot_group_member SET last_active = ? WHERE group_id = ? AND user_id = ?;

deleteGroupMembers:
DELETE FROM qqbot_group_member WHERE group_id = ?;
