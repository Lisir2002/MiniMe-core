      "emphasizedStiffness": { "$value": "300", "$type": "number", "$description": "强调弹簧刚度（MediumLow）" },
      "noBounceDamping":   { "$value": "1.0",  "$type": "number", "$description": "无回弹阻尼比" },
      "noBounceStiffness": { "$value": "300",  "$type": "number", "$description": "无回弹刚度（MediumLow）" }
    }
  }
